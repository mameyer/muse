<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net7.0</TargetFramework>
		<PackageId>TSGenerator</PackageId>
		<BuildOutputTargetFolder>tools</BuildOutputTargetFolder>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<IsPackable>true</IsPackable>
		
	    <Version>1.0.10</Version>
	
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="15.9.0" />
		<PackageReference Include="Microsoft.Build.Framework" Version="*" PrivateAssets="All" />
		<PackageReference Include="Microsoft.Build.Utilities.Core" Version="*" PrivateAssets="All" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
		<PackageReference Include="Moq" Version="4.10.1" />
		<PackageReference Include="NBuilder" Version="6.0.0" />
		<PackageReference Include="xunit" Version="2.4.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.4.0" />
		<PackageReference Include="xunit.runner.console" Version="2.4.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="xunit.runner.utility" Version="2.4.1" />
	</ItemGroup>
	
	<ItemGroup>
		<Content Include="build\*.targets" PackagePath="build\" />
	</ItemGroup>
	
	<ItemGroup>
	  <Folder Include="ResultTs\" />
	</ItemGroup>

	<Target Name="BeforeTargetsBuild" BeforeTargets="Build">
		<Message Text="TSGenerator: BeforeTargets=Build" Importance="High" />
	</Target>
</Project>
